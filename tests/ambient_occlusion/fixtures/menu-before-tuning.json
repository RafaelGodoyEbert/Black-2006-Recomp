FEConfirmYesGameCode RestartMission; set FEConfirmNoPage MissionFailed; page ConfirmWarning; gamecode SetupConfirmWarning RestartConfirm\r\nitem = $FE_QUIT | set FEConfirmYesGameCode QuitFromMissionFailed; set FEConfirmNoPage MissionFailed; page ConfirmWarning; gamecode SetupConfirmWarning QuitConfirm\r\n\r\n; The main menu, before any mission is done. EXIT GAME is not on the console page: it asks first (ExitGame below).\r\n[page blacktitlemenu2]\r\ncolumn = 00000000\r\nlogo = 299.5 54\r\nrails = 105 268\r\nlist = 319.5 150.5 25\r\nprompts = select confirm\r\nprompts_at = 317 398 28\r\nfocus = 1\r\nitem = $FE_STARTMISSION | page Difficulty\r\nitem = $FE_OPTIONS | page OptionsMenuXbox\r\nitem = \"EXIT GAME\" | open ExitGame\r\n\r\n; Before the game's own Difficulty page (from START MISSION and from the mission select): one player or two,\r\n; player two in the bottom half (split-screen, pc_split.h). set SplitPlayers 1 or 2 makes the choice, and then\r\n; the game's Difficulty page shows; BACK is that page's own back.\r\n[page Players]\r\ncolumn = 00000000\r\ntitle = \"PLAYERS\"\r\nlogo = 185.5 58\r\ntitle_at = 199 86\r\nrails = 47 170\r\nlist = 218 147 27\r\nselector = 349\r\ntext = 218 225 \"TWO PLAYERS: PLAYER TWO IN THE BOTTOM HALF, ON THE SECOND CONTROLLER OR THE ARROWS AND THE NUMPAD.\" | wrap 380 | size 12\r\nprompts_at = 218 399 28\r\nfocus = 1\r\nback = gamecode DifficultyBack\r\nitem = \"ONE PLAYER\" | set SplitPlayers 1\r\nitem = \"TWO PLAYERS (EXPERIMENTAL)\" | set SplitPlayers 2\r\n\r\n; The main menu once a mission is done.\r\n[page blacktitlemenu]\r\ncolumn = 00000000\r\nlogo = 269 54.5\r\nrails = 63.5 231\r\nlist = 285.5 150.5 25\r\nprompts = select confirm\r\nprompts_at = 286 399 28\r\nfocus = 1\r\nitem = $FE_CONTINUEMISSION | page MissionModeSelect\r\nitem = $FE_OPTIONS | page OptionsMenuXbox\r\nitem = $FE_OPERATORPROFILE | page OperatorProfile\r\nitem = \"EXIT GAME\" | open ExitGame\r\n\r\n; Not a page of the game: EXIT GAME opens it over the main menu, in the look of the front end's own questions.\r\n; The question is the game's own sentence.\r\n[page ExitGame]\r\ncolumn = 00000000\r\nlogo = 282.5 54\r\nrails = 94 247\r\ntext = 301 188 \"ARE YOU SURE YOU WANT TO QUIT?\"\r\nlist = 300.5 295 25\r\nfocus = 2\r\nprompts = select confirm\r\nprompts_at = 298 398 28\r\nback = close\r\nitem = $FE_YES | exit\r\nitem = $FE_NO | close\r\n"
